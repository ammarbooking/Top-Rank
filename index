/* Top Rank circular animated startup splash */
#fpSplash{position:fixed;inset:0;z-index:99999;overflow:hidden;display:grid;place-items:center;background:radial-gradient(circle at 50% 35%,#fff 0 32%,#f4f9ff 66%,#eaf4ff 100%);transition:opacity .75s ease,visibility .75s;isolation:isolate}
#fpSplash:before,#fpSplash:after{content:"";position:absolute;border-radius:50%;border:2px solid rgba(9,107,255,.08);z-index:-1;animation:fpBgPulse 3s ease-in-out infinite}
#fpSplash:before{width:720px;height:720px}#fpSplash:after{width:900px;height:900px;border-color:rgba(255,106,0,.06);animation-delay:.5s}
#fpSplash.hide{opacity:0;visibility:hidden;pointer-events:none}.fp-splash-inner{text-align:center;width:min(600px,94vw);position:relative;padding:22px}.fp-logo-shell{width:330px;height:330px;margin:auto;display:grid;place-items:center;position:relative;animation:fpShellIn .85s cubic-bezier(.16,1,.3,1) both}
.fp-logo-shell:before{content:"";position:absolute;inset:0;border-radius:50%;background:#fff;border:1px solid #bcd9ff;box-shadow:0 25px 65px rgba(14,79,145,.14),inset 0 0 0 12px rgba(235,246,255,.7);animation:fpCirclePulse 2.4s ease-in-out infinite}
.fp-logo-shell:after{content:"";position:absolute;inset:-27px;border-radius:50%;border:8px solid transparent;border-top-color:#0878f9;border-right-color:#0878f9;border-bottom-color:#ff7300;filter:drop-shadow(0 6px 10px rgba(9,107,255,.12));animation:fpSpin 3.2s linear infinite}
.fp-start-logo{position:relative;z-index:2;width:235px;height:235px;object-fit:contain;background:transparent!important;border-radius:50%;padding:16px;box-shadow:none!important;animation:fpLogoIn 1s .1s cubic-bezier(.16,1,.3,1) both}
.fp-start-title{font-size:42px;font-weight:900;color:#092548;margin-top:30px;animation:fpTextIn .65s .5s both}.fp-start-sub{font-size:25px;font-weight:900;color:#0878f9;margin-top:5px;animation:fpTextIn .65s .65s both}.fp-progress{height:8px;background:#dceafb;border-radius:999px;overflow:hidden;margin:27px auto 0;width:min(310px,70%);animation:fpTextIn .6s .8s both}.fp-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,#0878f9,#46a7ff);border-radius:inherit;box-shadow:0 0 12px rgba(9,107,255,.25);animation:fpLoad 2.3s .25s cubic-bezier(.3,.7,.2,1) forwards}.fp-loading{font-size:12px;font-weight:800;color:#7a91aa;margin-top:12px;animation:fpTextIn .6s .95s both}
@keyframes fpLogoIn{0%{opacity:0;transform:scale(.62) rotate(-8deg);filter:blur(8px)}70%{opacity:1;transform:scale(1.06);filter:blur(0)}100%{transform:scale(1)}}@keyframes fpShellIn{from{opacity:0;transform:scale(.75)}to{opacity:1;transform:scale(1)}}@keyframes fpTextIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}@keyframes fpCirclePulse{0%,100%{transform:scale(.985);box-shadow:0 25px 65px rgba(14,79,145,.12),inset 0 0 0 12px rgba(235,246,255,.7)}50%{transform:scale(1.02);box-shadow:0 30px 80px rgba(14,79,145,.20),inset 0 0 0 12px rgba(235,246,255,.9)}}@keyframes fpSpin{to{transform:rotate(360deg)}}@keyframes fpBgPulse{0%,100%{transform:scale(.95);opacity:.45}50%{transform:scale(1.04);opacity:1}}@keyframes fpLoad{0%{width:0}30%{width:31%}62%{width:67%}88%{width:91%}100%{width:100%}}
@media(max-width:650px){.fp-logo-shell{width:245px;height:245px}.fp-logo-shell:after{inset:-19px;border-width:6px}.fp-start-logo{width:180px;height:180px;padding:10px}.fp-start-title{font-size:32px;margin-top:24px}.fp-start-sub{font-size:20px}.fp-progress{margin-top:22px;width:245px}}
@media(prefers-reduced-motion:reduce){.fp-logo-shell,.fp-logo-shell:before,.fp-logo-shell:after,.fp-start-logo,.fp-start-title,.fp-start-sub,.fp-progress,.fp-progress span,#fpSplash:before,#fpSplash:after{animation-duration:.01ms!important}}

/* Top Rank: refreshed customer hero; original logo is preserved */
.hero{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);align-items:center;gap:clamp(20px,3vw,52px);padding:clamp(22px,3vw,48px);background:linear-gradient(135deg,#fff 15%,#f1f8ff 100%)}
.hero-visual{min-height:420px;display:flex;flex-direction:column;justify-content:center;gap:22px;border-radius:28px;background:radial-gradient(circle at 50% 45%,#fff 0%,#eaf4ff 60%,#dcecff 100%);border:1px solid #d9eaff;overflow:hidden}
.fp-hero-orbit{width:min(340px,85%);aspect-ratio:1;position:relative;display:grid;place-items:center}
