s:center;justify-content:center;background:radial-gradient(circle at 40% 35%,#dff0ff,transparent 35%)}.home-ill{font-size:170px;filter:drop-shadow(0 20px 35px rgba(9,107,255,.18))}.hero-text{text-align:center}.hero h1{font-size:40px;line-height:1.45;font-weight:900}.hero h1 span{display:block;color:#0b73ff}.features{display:flex;justify-content:center;gap:36px;margin-top:34px}.feature{width:110px;text-align:center;font-weight:900;color:#102744}.ficon{width:66px;height:66px;border:1px solid #bcd9ff;border-radius:18px;margin:0 auto 13px;display:grid;place-items:center;color:#086cff;font-size:31px;background:rgba(255,255,255,.7)}.order-box{border:1px solid #cfe2fb;background:rgba(255,255,255,.92);border-radius:22px;padding:24px;box-shadow:0 10px 35px rgba(21,75,130,.07)}.order-box h2{text-align:center;font-size:28px;margin-bottom:8px}.order-box p{text-align:center;color:#536478;font-weight:700;margin-bottom:20px}.form-grid{display:grid;gap:13px}.input-wrap{position:relative}.input-wrap .ico{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#0b73ff;font-size:22px;z-index:1}.input,.select,textarea{width:100%;border:1px solid #d5e4f5;border-radius:10px;background:#fff;color:#34445a;font-weight:800;outline:none}.input,.select{height:52px;padding:0 45px 0 15px}.select.multi{height:122px;padding:10px 45px 10px 15px}.multi-hint{font-size:12px;color:#63738a;font-weight:900;margin-top:-7px;background:#f8fbff;border:1px solid #e2eefc;border-radius:10px;padding:8px}textarea{height:100px;padding:13px;resize:vertical}.input:focus,.select:focus,textarea:focus{border-color:#0b73ff;box-shadow:0 0 0 4px rgba(11,115,255,.08)}.wide-btn{width:100%;height:58px;font-size:18px}.section-title{text-align:center;font-size:32px;font-weight:900;margin:28px 0 16px}.section-title:before,.section-title:after{content:"••";color:#0b73ff;margin:0 18px;letter-spacing:8px}.services{display:grid;grid-template-columns:repeat(6,1fr);gap:20px}.service{height:168px;border:1px solid var(--line);border-radius:16px;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;box-shadow:0 8px 24px rgba(30,82,130,.04);transition:.2s}.service:hover{transform:translateY(-5px);box-shadow:var(--shadow);border-color:#9bc6ff}.sicon{font-size:46px;color:#075ee4}.mini-btn{height:36px;padding:0 20px;border:1px solid #9ec8ff;background:#fff;color:#086cff;border-radius:7px;font-weight:900}.track-band{margin-top:30px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(135deg,#fff,#f0f7ff);min-height:130px;display:grid;grid-template-columns:170px 1fr 1.2fr 210px;align-items:center;gap:18px;padding:16px 28px;box-shadow:0 8px 24px rgba(30,82,130,.05)}.map{font-size:88px;text-align:center}.track-title h2{font-size:29px}.track-title p{color:#536478;font-weight:700;margin-top:8px}.track-fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}.result{display:none;margin-top:24px;border:1px solid var(--line);border-radius:18px;background:#fff;padding:22px;box-shadow:var(--shadow)}.result.open{display:block}.steps{display:grid;grid-template-columns:repeat(5,1fr);align-items:start;margin-top:18px}.step{text-align:center;position:relative}.step:not(:last-child):after{content:"";position:absolute;height:5px;background:#d3dbe6;top:34px;right:50%;width:100%;z-index:0}.step.done:not(:last-child):after{background:var(--green)}.dot{position:relative;z-index:1;margin:auto;width:68px;height:68px;border-radius:50%;background:#d3dae4;display:grid;place-items:center;font-size:28px;color:#42556c}.step.done .dot{background:var(--green);color:#fff}.step.active .dot{background:#096bff;color:#fff;box-shadow:0 0 0 8px rgba(9,107,255,.1)}.step b{display:block;margin-top:12px}.step small{color:#66778c;font-weight:800}.order-summary{margin-top:25px;border:1px solid #d7e7fb;border-radius:14px;padding:18px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px;background:#fbfdff}.order-summary b{display:block;margin-bottom:4px}.order-summary p{color:#536478;font-weight:800}.benefits{margin-top:30px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(135deg,#fff,#f5faff);display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:18px 35px}.benefit{display:flex;align-items:center;justify-content:center;gap:17px;font-weight:900}.bicon{width:62px;height:62px;border:1px solid #cfe2fb;border-radius:20px;background:#f4f9ff;display:grid;place-items:center;color:#0b73ff;font-size:33px}.footer{margin-top:36px;background:linear-gradient(90deg,var(--navy),#021425);color:#dcecff;padding:38px 60px 20px}.foot-grid{max-width:1400px;margin:auto;display:grid;grid-template-columns:1.2fr 1fr 1fr 1.2fr;gap:50px}.footer h3{color:#fff;margin-bottom:13px}.footer p,.footer li{line-height:2;color:#cfe1f6;font-weight:700}.footer ul{list-style:none}.copy{text-align:center;border-top:1px solid rgba(255,255,255,.12);margin-top:22px;padding-top:16px;color:#bcd1e8}.toast{position:fixed;bottom:22px;left:22px;background:#031d36;color:#fff;padding:14px 18px;border-radius:13px;box-shadow:0 15px 35px rgba(0,0,0,.25);display:none;z-index:80;font-weight:900}.toast.error{background:#b91c1c}.modal{position:fixed;inset:0;background:rgba(2,20,37,.55);display:none;align-items:center;justify-content:center;z-index:60;padding:18px}.modal.open{display:flex}.modal-card{width:min(540px,100%);background:#fff;border-radius:22px;padding:24px;box-shadow:0 30px 80px rgba(0,0,0,.25)}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.close{width:42px;height:42px;border:1px solid var(--line);border-radius:12px;background:#fff;font-size:25px}.note{font-size:13px;color:#64748b;font-weight:800;line-height:1.7;background:#f8fbff;border:1px solid #e2eefc;border-radius:12px;padding:10px}.db-state{font-size:12px;font-weight:900;color:#cfe1f6}.db-state.ok{color:#86efac}.db-state.off{color:#fdba74}
.service-picker{border:1px solid #d5e4f5;border-radius:16px;background:#fff;padding:13px;box-shadow:0 8px 24px rgba(30,82,130,.04)}
.service-picker-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;font-weight:900;color:#0b1f3a}
.service-count{background:#eaf4ff;color:#096bff;border:1px solid #cfe2fb;border-radius:999px;padding:7px 11px;font-size:12px;font-weight:900;white-space:nowrap}
