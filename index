.fp-hero-brand-img{width:100%;height:100%;object-fit:contain}
.fp-orbit-item{position:absolute;z-index:2;width:55px;height:55px;display:grid;place-items:center;border-radius:17px;background:#fff;border:1px solid #d5e8ff;box-shadow:0 9px 25px rgba(3,43,80,.12);font-size:27px}
.fp-orbit-one{top:3%;right:5%}.fp-orbit-two{bottom:14%;right:-3%}.fp-orbit-three{bottom:4%;left:6%}
.fp-hero-caption{font-size:28px;font-weight:900;color:#062b50;text-align:center;line-height:1.4}.fp-hero-caption small{display:block;font-size:15px;color:#526b86}
.fp-eyebrow{display:inline-flex;background:#e8f3ff;color:#096bff;border:1px solid #c8e1ff;border-radius:100px;padding:9px 17px;font-size:14px;font-weight:900;margin-bottom:15px}
.hero-text{text-align:right}.hero h1{font-size:clamp(27px,2.7vw,41px);line-height:1.35}.hero h1 span{display:block}.features{gap:13px;justify-content:space-between;margin-top:24px}.feature{width:auto;flex:1;font-size:13px}.ficon{width:56px;height:56px;border-radius:16px;margin-bottom:9px;font-size:26px}
.hero .order-box{margin-top:25px!important}
@keyframes fpHeroFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}@keyframes fpHeroSpin{to{transform:rotate(360deg)}}
@media(max-width:1100px){.hero{grid-template-columns:1fr}.hero-visual{min-height:310px}.fp-hero-orbit{width:230px}.fp-hero-caption{font-size:23px}}
@media(max-width:650px){.hero{padding:16px;gap:18px}.hero-visual{display:flex;min-height:245px;padding:12px}.fp-hero-orbit{width:170px}.fp-orbit-item{width:38px;height:38px;font-size:19px}.fp-hero-caption{font-size:21px}.fp-hero-caption small{font-size:12px}.hero-text{text-align:center}.features{display:flex;gap:5px}.feature{font-size:11px}.ficon{width:43px;height:43px;font-size:21px}.fp-eyebrow{font-size:12px}.hero h1,.hero h1 span{font-size:26px}}
@media(prefers-reduced-motion:reduce){.fp-hero-orbit:before,.fp-hero-orbit:after,.fp-hero-brand{animation:none}}

/* Clean, balanced hero redesign — logo asset unchanged */
.hero{grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:clamp(26px,4vw,64px);padding:clamp(26px,3.8vw,56px);background:linear-gradient(120deg,#ffffff 35%,#f3f8ff 100%);border-radius:30px;align-items:center}
.hero-visual.fp-clean-visual{min-height:350px;border:0;background:transparent;box-shadow:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;position:relative;overflow:visible;padding:12px}
.fp-clean-glow{position:absolute;width:min(330px,88%);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#d9ecff 0%,#edf6ff 52%,transparent 72%);filter:blur(4px);animation:fpGlow 5s ease-in-out infinite;pointer-events:none}
.fp-clean-logo{position:relative;z-index:1;width:min(260px,78%);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;background:#fff;border:1px solid #e1ecf9;box-shadow:0 20px 55px rgba(6,43,80,.11);padding:36px;animation:fpGentleRise 5s ease-in-out infinite}
.fp-clean-logo .fp-hero-brand-img{width:100%;height:100%;object-fit:contain}
.fp-clean-trust{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;gap:9px;flex-wrap:wrap;padding:12px 20px;border:1px solid #dce9f8;background:#fff;border-radius:999px;color:#0b2948;font-weight:900;font-size:16px;box-shadow:0 10px 28px rgba(5,42,80,.06)}
.fp-clean-trust small{font-size:12px;color:#657a91;font-weight:700}.fp-live-dot{width:9px;height:9px;border-radius:50%;background:#16b364;box-shadow:0 0 0 5px #e3f9ed}
.hero-text{text-align:right}.hero h1{font-size:clamp(29px,3.1vw,46px);line-height:1.35;letter-spacing:-.5px}.hero h1 span{color:#0878f9}.fp-eyebrow{background:#eef6ff;border:0;font-size:13px;padding:9px 14px}
